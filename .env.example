# 复制为 .env 后填入自己的值。.env 已被 .gitignore 挡住，不要提交。

# ── LLM（NL2SQL / RAG / Agent / AI 质检 / AI 风控 都用它）──
# 不配也能跑：链路、看板、对账全部正常，只是 AI 相关功能降级为规则模式
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── Doris（查询走 MySQL 协议 9030，Stream Load 导入走 HTTP 8030）──
DORIS_HOST=localhost
DORIS_QUERY_PORT=9030
DORIS_HTTP_PORT=8030
DORIS_USER=root
DORIS_PASSWORD=

# ── MySQL 业务库（模拟器写入 / Flink CDC 读 binlog / 对账任务比数）──
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root123
MYSQL_DATABASE=mall

# ── Kafka（ops_agent 探消费积压用）──
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ── Flink（ops_agent 探作业健康用）──
FLINK_REST_URL=http://localhost:8081
