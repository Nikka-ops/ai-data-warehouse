# 环境变量（含 API Key，绝对不能提交）。.env.example 是模板，可以提交。
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
venv/
env/
.venv/

# Flink connector jar（几十 MB，用 download_jars.ps1 从 Maven 拉）
flink/lib/*.jar

# Agent 生成的报告
reports/*.md

# 遗留的离线数据集，实时链路已不使用
data/

# ChromaDB 向量库（本地生成，不需要提交）
chroma_db/

# 临时文件
*.tmp
str
fix_encoding.py
test_agent.py

# phase 备份目录
phase2/
phase3/
phase4/
phase6/

# 日志
*.log
logs/

# IDE
.idea/
.vscode/
*.swp

# Docker 数据卷
airflow_logs/

# 评估脚本的输出
eval/reports/*.json

# submit.ps1 每次提交生成的带 run id 的 SQL
flink/sql/.run/
